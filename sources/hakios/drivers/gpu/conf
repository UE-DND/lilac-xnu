# drivers/gpu/conf: the GPU.
standard bsd/dev/lilac.gpu-snapshot.c
	help    Xperia A540 clock and power reads only, opt-in with lilac_gpu_snapshot=1
standard bsd/dev/lilac.rpm.c
	help    MSM8998 RPM transport for the A540 backend; inert until explicitly called
standard iokit/Kernel/hakios.gpu.cpp iokitcpp
	help    Shared Mesa IOKit service, compiled when an Adreno backend is selected

driver A540
	default n
	file    bsd/dev/lilac.a540.c
	help    MSM8998 A540 command, translation and rendering backend, opt-in with lilac_a540

# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver ADRENO
	file    bsd/dev/hakios.adreno.c
	help    the Adreno 642L of the SC7280 woken step by step (adreno=N), and HakiosGPU, the IOKit service Mesa and
	help    the window server draw through (gpu=1, adreno_keep=1). Needs the GPU's firmware from the phone (fw-gpu/)
